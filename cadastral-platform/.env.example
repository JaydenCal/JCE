# Cadastral platform: environment variables (copy to .env; never commit real secrets)
DATABASE_URL=postgresql://user:pass@localhost:5432/cadastral
UPLOAD_DIR=./var/uploads

# ---- "Talk to a civil engineer" enquiries ----
# Recipient mailbox(es), comma separated. NOT hard-coded anywhere: the owner sets this, e.g. the JCE Infrastructure enquiries mailbox.
ENQUIRY_TO=
# SMTP transport (leave ENQUIRY_SMTP_HOST empty to disable). Also used for the auto-acknowledgement to the submitter.
ENQUIRY_SMTP_HOST=
ENQUIRY_SMTP_PORT=587
ENQUIRY_SMTP_USER=
ENQUIRY_SMTP_PASSWORD=
ENQUIRY_SMTP_FROM=
ENQUIRY_SMTP_TLS=starttls          # starttls | ssl (port 465) | none
# Webhook transport (Slack / Teams / Zapier incoming webhook; https only). Optional.
ENQUIRY_WEBHOOK_URL=
# Outbox fallback: every undeliverable enquiry is also written here; used as the only transport if none above is set.
ENQUIRY_OUTBOX_DIR=./var/enquiry-outbox
ENQUIRY_UPLOAD_DIR=./var/uploads/enquiries
# Public API base URL, used to build attachment links in the partner email (download needs the partner token).
ENQUIRY_PUBLIC_BASE_URL=
# Shared secret for GET /enquiries/{ref}/attachments/{n} and POST /enquiries/retry (header X-Partner-Token). Empty disables both.
ENQUIRY_PARTNER_TOKEN=
# Abuse controls
ENQUIRY_MAX_PER_IP_HOUR=10
ENQUIRY_TRUST_XFF=0                # set 1 only behind a trusted reverse proxy
# Retry undelivered enquiries from cron: python -m app.notify.dispatch

# ---- Frontend ----
NEXT_PUBLIC_API_BASE=http://localhost:8000
