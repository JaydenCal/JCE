 "lodgement_guidance": [
  {
   "text": "From 1 July 2021, development applications and certificates must be lodged through the NSW Planning Portal.",
   "note": "",
   "citation": {
    "document_title": "NSW Planning Portal - Gunnedah Shire Council",
    "authority": "Gunnedah Shire Council",
    "version": "page text, retrieved",
    "effective_date": null,
    "page": 1,
    "section_ref": "NSW Planning Portal (Gunnedah Shire Council)",
    "quote": "From 1 July 2021, development applications and certificates must be lodged through the",
    "source_url": "https://www.gunnedah.nsw.gov.au/index.php/development/development-applications/nsw-planning-portal",
    "retrieved_at": "2026-10-12T17:16:24+00:00",
    "sha256": "091968b6a6f349112774c1a197f6c822618d5e54ae8ca15c53349c2cdd9f2531",
    "chunk_id": "g_portal"
   }
  },
  {
   "text": "Council can no longer accept hardcopy or emailed documents and cannot place applications on the portal on behalf of applicants.",
   "note": "",
   "citation": {
    "document_title": "NSW Planning Portal - Gunnedah Shire Council",
    "authority": "Gunnedah Shire Council",
    "version": "page text, retrieved",
    "effective_date": null,
    "page": 1,
    "section_ref": "NSW Planning Portal (Gunnedah Shire Council)",
    "quote": "These changes mean Council can no longer accept hardcopy or emailed documents",
    "source_url": "https://www.gunnedah.nsw.gov.au/index.php/development/development-applications/nsw-planning-portal",
    "retrieved_at": "2026-10-12T17:16:24+00:00",
    "sha256": "091968b6a6f349112774c1a197f6c822618d5e54ae8ca15c53349c2cdd9f2531",
    "chunk_id": "g_portal"
   }
  },
  {
   "text": "Before using the portal, get advice from the council's planning team; a free Duty Planner service is offered (02 6740 2100).",
   "note": "",
   "citation": {
    "document_title": "NSW Planning Portal - Gunnedah Shire Council",
    "authority": "Gunnedah Shire Council",
    "version": "page text, retrieved",
    "effective_date": null,
    "page": 1,
    "section_ref": "NSW Planning Portal (Gunnedah Shire Council)",
    "quote": "Council provides a free Duty Planner Service to assist with enquiries",
    "source_url": "https://www.gunnedah.nsw.gov.au/index.php/development/development-applications/nsw-planning-portal",
    "retrieved_at": "2026-10-12T17:16:24+00:00",
    "sha256": "091968b6a6f349112774c1a197f6c822618d5e54ae8ca15c53349c2cdd9f2531",
    "chunk_id": "g_portal"
   }
  },
  {
   "text": "Log in with an existing Service NSW account or register for a NSW Planning Portal account.",
   "note": "",
   "citation": {
    "document_title": "NSW Planning Portal - Gunnedah Shire Council",
    "authority": "Gunnedah Shire Council",
    "version": "page text, retrieved",
    "effective_date": null,
    "page": 1,
    "section_ref": "NSW Planning Portal (Gunnedah Shire Council)",
    "quote": "Use your existing Service NSW account or register for a NSW Planning Portal account.",
    "source_url": "https://www.gunnedah.nsw.gov.au/index.php/development/development-applications/nsw-planning-portal",
    "retrieved_at": "2026-10-12T17:16:24+00:00",
    "sha256": "091968b6a6f349112774c1a197f6c822618d5e54ae8ca15c53349c2cdd9f2531",
    "chunk_id": "g_portal"
   }
  },
  {
   "text": "Click 'New' to start the application, fill in the online form, and upload the required documents; the application can be saved and resumed.",
   "note": "",
   "citation": {
    "document_title": "NSW Planning Portal - Gunnedah Shire Council",
    "authority": "Gunnedah Shire Council",
    "version": "page text, retrieved",
    "effective_date": null,
    "page": 1,
    "section_ref": "NSW Planning Portal (Gunnedah Shire Council)",
    "quote": "Upload required documents to the portal. You can save your application and come back to it later.",
    "source_url": "https://www.gunnedah.nsw.gov.au/index.php/development/development-applications/nsw-planning-portal",
    "retrieved_at": "2026-10-12T17:16:24+00:00",
    "sha256": "091968b6a6f349112774c1a197f6c822618d5e54ae8ca15c53349c2cdd9f2531",
    "chunk_id": "g_portal"
   }
  },
  {
   "text": "A council officer reviews the application in the portal for completeness and emails if more information is needed.",
   "note": "",
   "citation": {
    "document_title": "NSW Planning Portal - Gunnedah Shire Council",
    "authority": "Gunnedah Shire Council",
    "version": "page text, retrieved",
    "effective_date": null,
    "page": 1,
    "section_ref": "NSW Planning Portal (Gunnedah Shire Council)",
    "quote": "A Council officer will review your application in the portal to make sure all documentation is correct.",
    "source_url": "https://www.gunnedah.nsw.gov.au/index.php/development/development-applications/nsw-planning-portal",
    "retrieved_at": "2026-10-12T17:16:24+00:00",
    "sha256": "091968b6a6f349112774c1a197f6c822618d5e54ae8ca15c53349c2cdd9f2531",
    "chunk_id": "g_portal"
   }
  },
  {
   "text": "Once accepted for lodgement an 'Additional Information Request' with the tax invoice is issued; fees must be paid and confirmed by responding in the portal before the DA is formally lodged.",
   "note": "",
