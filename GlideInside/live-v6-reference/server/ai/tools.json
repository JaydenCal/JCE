  {
    "name": "resize_room",
    "description": "Push or pull one side of a room. Positive delta grows the room outward on that side. Walls on that side move and connected walls stretch; a neighbouring room on that side shrinks. north = top of plan (-y), south = +y, east = +x, west = -x.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Room id"
        },
        "side": {
          "type": "string",
          "enum": [
            "north",
            "south",
            "east",
            "west"
          ],
          "description": "Side to move"
        },
        "delta": {
          "type": "number",
          "description": "Distance in mm, positive grows the room"
        }
      },
      "required": [
        "id",
        "side",
        "delta"
      ]
    }
  },
  {
    "name": "add_wall",
    "description": "Add a straight wall between two points (mm).",
    "input_schema": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "description": "Level id or name. Defaults to the active level."
        },
        "x1": {
          "type": "number",
          "description": "Start x"
        },
        "y1": {
          "type": "number",
          "description": "Start y"
        },
        "x2": {
          "type": "number",
          "description": "End x"
        },
        "y2": {
          "type": "number",
          "description": "End y"
        },
        "thickness": {
          "type": "number",
          "description": "Thickness in mm (default automatic)"
        },
        "status": {
          "type": "string",
          "enum": [
            "new",
            "existing",
            "demolish"
          ],
          "description": "Extension status. Default new."
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ]
    }
  },
  {
    "name": "update_wall",
    "description": "Change a wall thickness, height, extension status or give it its own external finish.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Wall id"
        },
        "thickness": {
          "type": "number",
          "description": "Thickness mm"
        },
        "height": {
          "type": "number",
          "description": "Wall height mm (omit to follow the level)"
        },
        "status": {
          "type": "string",
          "enum": [
            "new",
            "existing",
            "demolish"
          ],
          "description": "Extension status. Default new."
        },
        "finish_material": {
          "type": "string",
          "description": "Wall material id for this wall only"
        },
        "finish_colour": {
          "type": "string",
          "description": "Wall colour id for this wall only"
        },
        "clear_finish": {
          "type": "boolean",
          "description": "Remove this wall’s own finish so it follows the house"
        }
      },
      "required": [
        "id"
      ]
    }
  },
  {
    "name": "move_wall",
    "description": "Move a wall by (dx, dy) mm. Walls connected to it stretch and rooms bounded by it change shape.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Wall id"
        },
        "dx": {
          "type": "number",
          "description": "mm east"
        },
        "dy": {
          "type": "number",
          "description": "mm south"
        }
      },
      "required": [
        "id"
      ]
    }
  },
  {
    "name": "add_opening",
    "description": "Add a window, door, sliding door, garage door, roller door or plain opening to a wall. Give either the wall id (with optional offset of the opening centre from the wall start) or a point (x, y) near the wall.",
    "input_schema": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "description": "Level id or name. Defaults to the active level."
        },
        "wall": {
          "type": "string",
          "description": "Wall id"
        },
        "x": {
          "type": "number",
          "description": "Point near the wall, mm"
        },
        "y": {
          "type": "number",
          "description": "Point near the wall, mm"
        },
        "kind": {
          "type": "string",
          "enum": [
            "window",
            "door",
            "sliding_door",
            "garage_door",
            "roller_door",
            "opening"
          ],
          "description": "Opening kind"
        },
        "offset": {
          "type": "number",
          "description": "Distance from wall start to opening centre, mm"
        },
        "width": {
          "type": "number",
          "description": "Width mm"
        },
        "height": {
          "type": "number",
          "description": "Height mm"
        },
        "sill": {
          "type": "number",
          "description": "Sill height mm (windows)"
        },
        "style": {
          "type": "string",
          "description": "Window style: sliding, awning, fixed, double_hung, louvre"
        },
        "hinge": {
          "type": "string",
          "enum": [
            "a",
            "b"
          ],
          "description": "Door hinge end"
        },
        "side": {
          "type": "number",
          "description": "Door swing side: 1 or -1"
        },
        "status": {
          "type": "string",
          "enum": [
            "new",
            "existing",
            "demolish"
          ],
          "description": "Extension status. Default new."
        }
      },
      "required": [
        "kind"
      ]
    }
  },
