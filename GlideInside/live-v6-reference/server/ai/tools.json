[
  {
    "name": "add_room",
    "description": "Add a rectangular room. (x, y) is the north-west (top-left) corner in mm; width runs east (+x), depth runs south (+y). Walls are created on edges that are not already walled. Decks, patios and carports get no walls by default.",
    "input_schema": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "description": "Level id or name. Defaults to the active level."
        },
        "name": {
          "type": "string",
          "description": "Room name, e.g. \"Bed 2\""
        },
        "type": {
          "type": "string",
          "enum": [
            "living",
            "family",
            "kitchen",
            "dining",
            "bedroom",
            "bathroom",
            "ensuite",
            "wc",
            "laundry",
            "garage",
            "carport",
            "study",
            "entry",
            "hall",
            "robe",
            "pantry",
            "media",
            "rumpus",
            "workshop",
            "store",
            "deck",
            "patio",
            "alfresco",
            "verandah",
            "other"
          ],
          "description": "Room type"
        },
        "x": {
          "type": "number",
          "description": "West edge, mm"
        },
        "y": {
          "type": "number",
          "description": "North edge, mm"
        },
        "width": {
          "type": "number",
          "description": "East-west size, mm"
        },
        "depth": {
          "type": "number",
          "description": "North-south size, mm"
        },
        "walls": {
          "type": "boolean",
          "description": "Create walls (default true for indoor rooms)"
        },
        "status": {
          "type": "string",
          "enum": [
            "new",
            "existing",
            "demolish"
          ],
          "description": "Extension status. Default new."
        }
      },
      "required": [
        "type",
        "x",
        "y",
        "width",
        "depth"
      ]
    }
  },
  {
    "name": "add_room_polygon",
    "description": "Add a room with any outline, given as corner points in mm in order.",
    "input_schema": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "description": "Level id or name. Defaults to the active level."
        },
        "name": {
          "type": "string",
          "description": "Room name"
        },
        "type": {
          "type": "string",
          "enum": [
            "living",
            "family",
            "kitchen",
            "dining",
            "bedroom",
            "bathroom",
            "ensuite",
            "wc",
            "laundry",
            "garage",
            "carport",
            "study",
            "entry",
            "hall",
            "robe",
            "pantry",
            "media",
            "rumpus",
            "workshop",
            "store",
            "deck",
            "patio",
            "alfresco",
            "verandah",
            "other"
          ],
          "description": "Room type"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "description": "Corner points in order"
        },
        "walls": {
          "type": "boolean",
          "description": "Create walls"
        },
        "status": {
          "type": "string",
          "enum": [
            "new",
            "existing",
            "demolish"
          ],
          "description": "Extension status. Default new."
        }
      },
      "required": [
        "type",
        "points"
      ]
    }
  },
  {
    "name": "update_room",
